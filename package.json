{
  "name": "codex-claude-agent-bridge",
  "version": "0.1.0",
  "description": "Local MCP bridge for delegating Codex Desktop tasks to Claude, Codex CLI, Gemini, and OpenCode agents.",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZackerRoo/codex-cluade.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "bin": {
    "claude-agent-bridge": "dist/src/cli.js",
    "claude-agent-bridge-mcp": "dist/src/mcpServer.js",
    "claude-agent-bridge-dashboard": "dist/src/dashboardCli.js",
    "claude-agent-bridge-mcp-dashboard": "dist/src/mcpDashboardServer.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release:check": "npm run typecheck && npm test && node dist/src/releaseCheckCli.js",
    "install:smoke": "npm run build && node dist/src/installSmokeCli.js",
    "bridge": "npm run build && node dist/src/cli.js",
    "doctor": "npm run build && node dist/src/cli.js doctor",
    "mcp": "npm run build && node dist/src/mcpServer.js",
    "dashboard": "npm run build && node dist/src/dashboardCli.js",
    "mcp-dashboard": "npm run build && node dist/src/mcpDashboardServer.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "typescript": "^5.7.0",
    "zod": "^4.4.3"
  }
}
